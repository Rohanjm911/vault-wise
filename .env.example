# ==============================================================================
# Vaultwise Environment Configuration (Example)
# Copy to .env in production / local dev. Never commit actual secrets!
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=True

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL 18)
# For local dev / testing fallback: sqlite:///./vaultwise_dev.db or PostgreSQL connection string:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vaultwise
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/vaultwise

# Authentication & Security
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-with-a-very-long-and-cryptographically-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Hashing
BCRYPT_ROUNDS=12

# Optional AI Analysis (Default: Disabled, requires explicit user opt-in in UI)
# When disabled or omitted, Vaultwise uses 100% deterministic local/server calculations
AI_ANALYSIS_ENABLED=False
AI_PROVIDER=none
AI_API_KEY=

# Storage and Upload Limits
MAX_UPLOAD_SIZE_BYTES=10485760 # 10MB
ALLOWED_UPLOAD_EXTENSIONS=.csv,.xlsx,.xls
